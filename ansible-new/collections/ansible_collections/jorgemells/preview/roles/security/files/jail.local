[DEFAULT]
# Whitelist your own home/office static IPs here!
ignoreip = 127.0.0.1/8 ::1

# Lock them out for at least 1 day on the first offense
bantime = 1d

# Look back a 10-minute window for failures
findtime = 10m

# Ban after 5 failed attempts
maxretry = 5

[sshd]
enabled = true
port = ssh
logpath = %(sshd_log)s
backend = systemd
