[server]
environment = {{ app_environment }}
debug_mode = {{ app_debug_enabled | bool }}
max_workers = {{ app_worker_ports | length }}

[backend_listeners]
{% for port in app_worker_ports %}
listener_{{ loop.index }} = 127.0.0.1:{{ port }}
{% endfor %}
