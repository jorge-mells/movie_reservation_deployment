- id: "deploy"
  execute-command: "{{ app_dir }}/redeploy.sh"
  command-working-directory: "{{ app_dir }}"
  response-message: "Deployment triggered successfully!"
  trigger-rule:
    match:
      type: "payload-hmac-sha256"
      secret: "{{ webhook_secret }}"
      parameter:
        source: "header"
        name: "X-Hub-Signature-256"      
