[Unit]
Description=My Custom Python App Service
After=network.target

[Service]
Type=simple
User=my-app
Group=webapp
WorkingDirectory=/etc/my-app
ExecStart=/usr/bin/python3 -m http.server 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
